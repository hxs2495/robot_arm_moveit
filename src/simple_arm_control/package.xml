<?xml version="1.0"?>
<package format="3">
  <name>simple_arm_control</name>
  <version>0.1.0</version>
  <description>MoveIt 2 command examples and launch files for the simple arm.</description>
  <maintainer email="maintainer@example.com">Robot Arm Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>rclcpp</depend>
  <depend>tl_expected</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>simple_arm_moveit_config</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
