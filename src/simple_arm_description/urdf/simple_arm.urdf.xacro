<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="simple_arm">
  <xacro:arg name="use_mock_hardware" default="true"/>

  <material name="arm_blue"><color rgba="0.025 0.30 0.66 1.0"/></material>
  <material name="joint_dark"><color rgba="0.035 0.050 0.075 1.0"/></material>
  <material name="accent_cyan"><color rgba="0.00 0.72 0.84 1.0"/></material>
  <material name="machined_metal"><color rgba="0.48 0.55 0.62 1.0"/></material>
  <material name="rubber_black"><color rgba="0.015 0.020 0.028 1.0"/></material>
  <material name="tool_orange"><color rgba="1.00 0.32 0.035 1.0"/></material>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
               iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
               izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <link name="base_link">
    <visual><origin xyz="0 0 0.018"/><geometry><cylinder radius="0.135" length="0.036"/></geometry><material name="rubber_black"/></visual>
    <visual><origin xyz="0 0 0.070"/><geometry><cylinder radius="0.115" length="0.090"/></geometry><material name="arm_blue"/></visual>
    <visual><origin xyz="0 0 0.112"/><geometry><cylinder radius="0.119" length="0.014"/></geometry><material name="accent_cyan"/></visual>
    <visual><origin xyz="0 0 0.127"/><geometry><cylinder radius="0.097" length="0.020"/></geometry><material name="joint_dark"/></visual>
    <collision><origin xyz="0 0 0.06"/><geometry><cylinder radius="0.11" length="0.12"/></geometry></collision>
  </link>

  <link name="link_1">
    <visual><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.057" length="0.245"/></geometry><material name="arm_blue"/></visual>
    <visual><origin xyz="0 0 0.015"/><geometry><sphere radius="0.081"/></geometry><material name="joint_dark"/></visual>
    <visual><origin xyz="0 0 0.063"/><geometry><cylinder radius="0.061" length="0.022"/></geometry><material name="accent_cyan"/></visual>
    <visual><origin xyz="0 0 0.295"/><geometry><sphere radius="0.078"/></geometry><material name="joint_dark"/></visual>
    <visual><origin xyz="0 0 0.268"/><geometry><cylinder radius="0.061" length="0.020"/></geometry><material name="machined_metal"/></visual>
    <collision><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.065" length="0.30"/></geometry></collision>
    <xacro:box_inertial mass="2.5" x="0.13" y="0.13" z="0.30"/>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/>
    <origin xyz="0 0 0.12"/><axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="80" velocity="1.5"/>
  </joint>

  <link name="link_2">
    <visual><origin xyz="0.16 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.045" length="0.255"/></geometry><material name="arm_blue"/></visual>
    <visual><origin xyz="0.012 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.074" length="0.105"/></geometry><material name="joint_dark"/></visual>
    <visual><origin xyz="0.075 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.051" length="0.020"/></geometry><material name="accent_cyan"/></visual>
    <visual><origin xyz="0.310 0 0"/><geometry><sphere radius="0.068"/></geometry><material name="joint_dark"/></visual>
    <collision><origin xyz="0.16 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.052" length="0.32"/></geometry></collision>
    <xacro:box_inertial mass="2.0" x="0.32" y="0.104" z="0.104"/>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/>
    <origin xyz="0 0 0.30"/><axis xyz="0 1 0"/>
    <limit lower="-2.35" upper="2.35" effort="70" velocity="1.5"/>
  </joint>

  <link name="link_3">
    <visual><origin xyz="0.14 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.041" length="0.220"/></geometry><material name="arm_blue"/></visual>
    <visual><origin xyz="0.010 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.066" length="0.095"/></geometry><material name="joint_dark"/></visual>
    <visual><origin xyz="0.070 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.047" length="0.018"/></geometry><material name="machined_metal"/></visual>
    <visual><origin xyz="0.270 0 0"/><geometry><sphere radius="0.057"/></geometry><material name="joint_dark"/></visual>
    <visual><origin xyz="0.226 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.047" length="0.018"/></geometry><material name="accent_cyan"/></visual>
    <collision><origin xyz="0.14 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.047" length="0.28"/></geometry></collision>
    <xacro:box_inertial mass="1.5" x="0.28" y="0.094" z="0.094"/>
  </link>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/>
    <origin xyz="0.32 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.60" upper="2.60" effort="60" velocity="1.8"/>
  </joint>

  <link name="link_4">
    <visual><origin xyz="0.055 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.042" length="0.105"/></geometry><material name="joint_dark"/></visual>
    <visual><origin xyz="0.020 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.049" length="0.018"/></geometry><material name="machined_metal"/></visual>
    <visual><origin xyz="0.096 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.047" length="0.014"/></geometry><material name="accent_cyan"/></visual>
    <collision><origin xyz="0.06 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.040" length="0.12"/></geometry></collision>
    <xacro:box_inertial mass="0.8" x="0.12" y="0.08" z="0.08"/>
  </link>
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/><child link="link_4"/>
    <origin xyz="0.28 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="35" velocity="2.2"/>
  </joint>

  <link name="link_5">
    <visual><origin xyz="0.05 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.034" length="0.085"/></geometry><material name="arm_blue"/></visual>
    <visual><origin xyz="0.010 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.046" length="0.075"/></geometry><material name="joint_dark"/></visual>
    <visual><origin xyz="0.082 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.039" length="0.016"/></geometry><material name="machined_metal"/></visual>
    <collision><origin xyz="0.05 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.035" length="0.10"/></geometry></collision>
    <xacro:box_inertial mass="0.5" x="0.10" y="0.07" z="0.07"/>
  </link>
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/><child link="link_5"/>
    <origin xyz="0.12 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.20" upper="2.20" effort="25" velocity="2.2"/>
  </joint>

  <link name="link_6">
    <visual><origin xyz="0.045 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.030" length="0.080"/></geometry><material name="joint_dark"/></visual>
    <visual><origin xyz="0.012 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.037" length="0.015"/></geometry><material name="accent_cyan"/></visual>
    <visual><origin xyz="0.078 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.035" length="0.018"/></geometry><material name="machined_metal"/></visual>
    <collision><origin xyz="0.05 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.030" length="0.10"/></geometry></collision>
    <xacro:box_inertial mass="0.35" x="0.10" y="0.06" z="0.06"/>
  </link>
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/><child link="link_6"/>
    <origin xyz="0.10 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="20" velocity="2.5"/>
  </joint>

  <link name="tool0">
    <visual><origin xyz="0.015 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.044" length="0.030"/></geometry><material name="tool_orange"/></visual>
    <visual><origin xyz="0.052 0 0"/><geometry><box size="0.060 0.090 0.065"/></geometry><material name="joint_dark"/></visual>
    <visual><origin xyz="0.112 0.037 0"/><geometry><box size="0.100 0.016 0.024"/></geometry><material name="machined_metal"/></visual>
    <visual><origin xyz="0.112 -0.037 0"/><geometry><box size="0.100 0.016 0.024"/></geometry><material name="machined_metal"/></visual>
    <visual><origin xyz="0.157 0.037 -0.012"/><geometry><box size="0.018 0.022 0.045"/></geometry><material name="rubber_black"/></visual>
    <visual><origin xyz="0.157 -0.037 -0.012"/><geometry><box size="0.018 0.022 0.045"/></geometry><material name="rubber_black"/></visual>
    <collision><origin xyz="0.045 0 0"/><geometry><box size="0.09 0.07 0.07"/></geometry></collision>
    <xacro:box_inertial mass="0.2" x="0.09" y="0.07" z="0.07"/>
  </link>
  <joint name="tool0_fixed_joint" type="fixed">
    <parent link="link_6"/><child link="tool0"/><origin xyz="0.10 0 0"/>
  </joint>

  <ros2_control name="SimpleArmSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="calculate_dynamics">false</param>
    </hardware>
    <xacro:macro name="mock_joint" params="joint_name initial_position">
      <joint name="${joint_name}">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">${initial_position}</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:mock_joint joint_name="joint_1" initial_position="0.0"/>
    <xacro:mock_joint joint_name="joint_2" initial_position="-0.65"/>
    <xacro:mock_joint joint_name="joint_3" initial_position="1.15"/>
    <xacro:mock_joint joint_name="joint_4" initial_position="0.0"/>
    <xacro:mock_joint joint_name="joint_5" initial_position="-0.50"/>
    <xacro:mock_joint joint_name="joint_6" initial_position="0.0"/>
  </ros2_control>
</robot>
