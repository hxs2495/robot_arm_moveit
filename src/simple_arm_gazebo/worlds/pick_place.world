<?xml version="1.0"?>
<sdf version="1.6">
  <world name="simple_arm_pick_place">
    <gravity>0 0 -9.81</gravity>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <ode><solver><iters>100</iters></solver></ode>
    </physics>
    <scene>
      <ambient>0.35 0.40 0.50 1</ambient>
      <background>0.05 0.08 0.13 1</background>
      <shadows>true</shadows>
    </scene>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.65 -1.65 1.25 0 0.40 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <model name="work_table">
      <static>true</static>
      <pose>0.62 0 0.18 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.58 0.78 0.36</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.58 0.78 0.36</size></box></geometry>
          <material>
            <ambient>0.08 0.12 0.18 1</ambient>
            <diffuse>0.10 0.18 0.28 1</diffuse>
            <specular>0.35 0.45 0.60 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="pick_cube">
      <pose>0.50 0.20 0.395 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.08</mass>
          <inertia><ixx>0.000048</ixx><iyy>0.000048</iyy><izz>0.000048</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material>
            <ambient>1.0 0.22 0.03 1</ambient>
            <diffuse>1.0 0.32 0.04 1</diffuse>
            <specular>0.50 0.20 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
